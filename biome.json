{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"src/**",
			"test/**",
			"tools/**",
			"!**/*.md",
			"!test/replay/fixtures/**",
			"!dist/**",
			"!node_modules/**"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
