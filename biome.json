{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**",
			"test/**",
			"tools/**",
			"!**/*.md",
			"!test/fixtures/support-replay/**",
			"!test/fixtures/command-parity/**",
			"!src/runtime/native/**",
			"!src/hosts/dashboard/ui/vendor/**",
			"!dist/**",
			"!node_modules/**"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
