{
	"type": "object",
	"required": ["schema", "digest", "lenses"],
	"properties": {
		"schema": { "const": "e2e-triage-control-v1" },
		"digest": { "type": "string", "minLength": 1 },
		"lenses": {
			"type": "array",
			"minItems": 1,
			"maxItems": 8,
			"items": {
				"type": "object",
				"required": ["id", "focus"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"focus": { "type": "string" }
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
