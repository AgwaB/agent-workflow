{
  "type": "object",
  "required": ["schema", "digest", "inputIntegrity", "synthesis"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "deep-research-final-synthesis-v2"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "inputIntegrity": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["complete", "blocked"] },
        "reason": {
          "type": "string",
          "enum": ["truncated_read", "missing_read", "inconsistent_input", "budget_block"]
        },
        "detail": { "type": "string", "maxLength": 600 }
      },
      "additionalProperties": false
    },
    "synthesis": {
      "type": "object",
      "required": [
        "bottomLine",
        "comparisonRows",
        "keyFindingIds",
        "recommendations",
        "actionPlan",
        "caveatNotes",
        "parentDecisionNotes"
      ],
      "properties": {
        "bottomLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "comparisonRows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["area", "subjectStatus", "referencePattern", "assessment", "supportingClaimIds"],
            "properties": {
              "area": { "type": "string", "minLength": 1, "maxLength": 200 },
              "subjectStatus": { "type": "string", "minLength": 1, "maxLength": 800 },
              "referencePattern": { "type": "string", "minLength": 1, "maxLength": 800 },
              "assessment": { "type": "string", "minLength": 1, "maxLength": 800 },
              "supportingClaimIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
              "evidenceStatus": { "type": "string" }
            },
            "additionalProperties": true
          },
          "maxItems": 8
        },
        "keyFindingIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 12
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recommendation", "supportingClaimIds"],
            "properties": {
              "recommendation": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "supportingClaimIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
              "evidenceStatus": { "type": "string" },
              "rationale": { "type": "string", "maxLength": 1200 }
            },
            "additionalProperties": true
          },
          "maxItems": 12
        },
        "actionPlan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "supportingClaimIds"],
            "properties": {
              "step": {},
              "action": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "supportingClaimIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
              "evidenceStatus": { "type": "string" }
            },
            "additionalProperties": true
          },
          "maxItems": 12
        },
        "caveatNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["note"],
            "properties": {
              "note": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "readerNote": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "relatedClaimIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
              "gapIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
            },
            "additionalProperties": true
          },
          "maxItems": 16
        },
        "parentDecisionNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["note", "whyItMatters", "evidenceStatus", "suggestedParentDecision"],
            "properties": {
              "note": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "whyItMatters": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "evidenceStatus": { "type": "string" },
              "suggestedParentDecision": { "type": "string", "maxLength": 1200 },
              "supportingClaimIds": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
            },
            "additionalProperties": true
          },
          "maxItems": 12
        },
        "notableUnsupportedClaimIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 12
        },
        "contestedClaimIds": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 12
        },
        "translations": {
          "type": "object",
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
                  "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 }
                },
                "additionalProperties": true
              },
              "maxItems": 96
            },
            "factSlots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "area"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "area": { "type": "string", "minLength": 1, "maxLength": 400 },
                  "whyItMatters": { "type": "string", "minLength": 1, "maxLength": 2000 }
                },
                "additionalProperties": true
              },
              "maxItems": 64
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
