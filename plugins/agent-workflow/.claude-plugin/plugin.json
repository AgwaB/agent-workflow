{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "agent-workflow",
  "version": "0.1.0",
  "description": "Run agent-workflow multi-agent workflows (deep-review, deep-research, spec-review, impact-review, dynamic) from the conversation: launch, wait, inspect and stop runs through the agent-workflow MCP server.",
  "author": {
    "name": "AgwaB",
    "url": "https://github.com/AgwaB"
  },
  "homepage": "https://github.com/AgwaB/agent-workflow#readme",
  "repository": "https://github.com/AgwaB/agent-workflow",
  "license": "MIT",
  "keywords": [
    "workflow",
    "agents",
    "mcp",
    "review",
    "research"
  ],
  "mcpServers": {
    "agent-workflow": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@agwab/agent-workflow@0.1.0",
        "agent-workflow-mcp",
        "--host",
        "claude-code"
      ]
    }
  }
}
