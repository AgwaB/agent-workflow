  "license": "MIT",
  "keywords": [
    "workflow",
    "agents",
    "mcp",
    "review",
    "research"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "agent-workflow": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@agwab/agent-workflow@0.1.0",
        "agent-workflow-mcp",
        "--host",
        "codex",
        "--tool-timeout-ms",
        "1920000"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 1920
    }
  },
  "interface": {
    "displayName": "agent-workflow",
    "shortDescription": "Run multi-agent workflows (review, research) and report their results",
    "developerName": "AgwaB",
    "category": "Coding",
    "websiteURL": "https://github.com/AgwaB/agent-workflow"
  }
}
