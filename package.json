{
  "name": "@agwab/agent-workflow",
  "version": "0.1.0",
  "description": "Host-agnostic workflow engine for coding-agent CLIs (pre-alpha skeleton).",
  "private": false,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src/hosts/cli/cli.mjs",
    "src/mcp/host-server/bin.mjs",
    "agents",
    "workflows",
    "skills",
    "plugins/pi",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "workflow",
    "agent",
    "codex",
    "claude",
    "pi"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/testing": {
      "types": "./dist/sdk/testing/index.d.ts",
      "default": "./dist/sdk/testing/index.js"
    },
    "./sdk/conformance": {
      "types": "./dist/sdk/conformance/index.d.ts",
      "default": "./dist/sdk/conformance/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./executors/pi": {
      "types": "./dist/executors/pi/index.d.ts",
      "default": "./dist/executors/pi/index.js"
    },
    "./executors/codex": {
      "types": "./dist/executors/codex/index.d.ts",
      "default": "./dist/executors/codex/index.js"
    },
    "./executors/claude": {
      "types": "./dist/executors/claude/index.d.ts",
      "default": "./dist/executors/claude/index.js"
    },
    "./executors/acp": {
      "types": "./dist/executors/acp/index.d.ts",
      "default": "./dist/executors/acp/index.js"
    },
    "./hosts/api": {
      "types": "./dist/hosts/api.d.ts",
      "default": "./dist/hosts/api.js"
    },
    "./hosts/cli": {
      "types": "./dist/hosts/cli/index.d.ts",
      "default": "./dist/hosts/cli/index.js"
    },
    "./hosts/pi": {
      "types": "./dist/hosts/pi/index.d.ts",
      "default": "./dist/hosts/pi/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-workflow": "src/hosts/cli/cli.mjs",
    "agent-workflow-mcp": "src/mcp/host-server/bin.mjs"
  },
  "pi": {
    "extensions": [
      "./dist/hosts/pi/index.js"
    ],
    "skills": [
      "./plugins/pi/skills/workflow-guide",
      "./plugins/pi/skills/execution-router"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --outDir dist --noEmit false && node tools/release/copy-runtime-assets.mjs",
    "build:native:darwin": "node tools/release/build-darwin-process-identity.mjs",
    "typecheck": "tsc --noEmit",
    "check:scripts": "node tools/release/check-scripts.mjs",
    "check:release-workflow": "node tools/release/check-publish-workflow.mjs",
    "check:public-surface": "node tools/release/check-public-surface.mjs",
    "validate": "npm run check:scripts && npm run check:release-workflow && npm run check:public-surface && npm run check:format && npm run typecheck && npm run test:unit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node test/run-unit.mjs",
    "test:ui-motion": "npm run build && AGENT_WORKFLOW_UI_MOTION=1 node test/run-unit.mjs test/unit/host-dashboard-ui.test.mjs test/unit/host-dashboard-redesign.test.mjs test/unit/host-dashboard-morph.test.mjs",
    "e2e": "node test/e2e/run.mjs",
    "pack:dry": "npm pack --dry-run --json --ignore-scripts",
    "prepack": "npm run build",
    "release:check": "node tools/release/release-check.mjs",
    "release:dispatch": "node tools/release/dispatch-release.mjs",
    "format": "biome format --write .",
    "check:format": "biome format ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgwaB/agent-workflow.git"
  },
  "homepage": "https://github.com/AgwaB/agent-workflow#readme",
  "bugs": {
    "url": "https://github.com/AgwaB/agent-workflow/issues"
  }
}
